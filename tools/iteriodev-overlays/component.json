    {
      "path": "icons/hmi-wheel.png",
      "from": "icons/hmi-wheel.png",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "iteriodev-overlays.service",
      "from": "iteriodev-overlays.service"
    }
  ],
  "enable": [
    {
      "unit": "iteriodev-overlays.service",
      "target": "multi-user.target"
    }
  ],
  "dropins": [
    {
      "unit": "mgu-render.service",
      "name": "iteriodev-overlays.conf",
      "from": "mgu-render-overlays.conf"
    }
  ],
  "recmgr": [
    "iteriodev-overlays"
  ],

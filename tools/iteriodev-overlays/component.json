    {
      "path": "icons/hmi-heat-driver.png",
      "from": "icons/hmi-heat-driver.png",
      "mode": "0644"
    },
    {
      "path": "icons/hmi-heat-passenger.png",
      "from": "icons/hmi-heat-passenger.png",
      "mode": "0644"
    },
    {
      "path": "icons/hmi-cool-driver.png",
      "from": "icons/hmi-cool-driver.png",
      "mode": "0644"
    },
    {
      "path": "icons/hmi-cool-passenger.png",

{
  "id": "iteriodev-screencast",
  "kind": "tool",
  "version": "1.0.12",
  "title": "Screen share",
  "description": "The centre display in a browser (http://<head unit>:5880/ over your tailnet, or an SSH -L tunnel), clicks and drags become touches; a MENU button goes back to the BMW menu, e.g. out of full-screen CarPlay (iDrive 7 and 8). Auto-sizes to any panel (ID7/ID8)",
  "optional": true,
  "uninstallable": true,
  "requires": { "iteriodev-tailscale": "1.104.4", "mgu-deploy": "0.7.11" },
  "mguHmi": ["ID7", "ID8"],
  "files": [
    { "path": "screencast.js", "from": "screencast.js", "mode": "0644" },
    { "path": "index.html", "from": "index.html", "mode": "0644" },
    { "path": "mux.js", "from": "mux.js", "mode": "0644" },
    { "path": "menu.js", "from": "menu.js", "mode": "0644" },
    { "path": "hmictl", "from": "hmictl", "mode": "0755" }
  ],
  "units": [
    { "name": "iteriodev-screencast.service", "from": "iteriodev-screencast.service" },
    { "name": "iteriodev-screencast-menu.service", "from": "iteriodev-screencast-menu.service" }
  ],
  "enable": [
    { "unit": "iteriodev-screencast.service", "target": "multi-user.target" },
    { "unit": "iteriodev-screencast-menu.service", "target": "multi-user.target" }
  ],
  "recmgr": ["iteriodev-screencast", "iteriodev-screencast-menu"],
  "crashNames": ["hmictl"],
  "restart": ["iteriodev-screencast.service", "iteriodev-screencast-menu.service"]
}

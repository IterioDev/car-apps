[Unit]
Description=Drive Recorder player for the Drive Recorder app (clips to the GPU renderer, thumbnails, lock, delete, Copy to USB)
After=mgu-render.service

[Service]
# root: the thumbnail and socket folders, the renderer's frame file, the clip folders' locked/ (setup.sh)
ExecStartPre=/bin/sh /var/opt/iteriodev-drplay/current/setup.sh
# root on purpose (no runas): mgu-drplay first forks its Copy to USB child, which stays root (udisks mounts a stick for
# the user that asked for it), then drops itself to uid 3912, gid 929 mgu_driverec, groups 929 + 903 mgu_persist.
# No internet.
ExecStart=/var/opt/iteriodev-drplay/current/mgu-drplay
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

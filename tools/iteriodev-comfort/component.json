{
  "id": "iteriodev-comfort",
  "kind": "tool",
  "version": "0.7.0",
  "title": "Comfort",
  "description": "Service behind Ambient Light and Seats. A manual Calibration page saves driving/Exit positions and a buffered rear limit before any driver automation is enabled. Independent Fixed/Adaptive Drive and Exit modes; passenger automation deferred, manual controls retained.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "comfort.js",
      "from": "comfort.js",
      "mode": "0644"
    },
    {
      "path": "driver-access.js",
      "from": "driver-access.js",
      "mode": "0644"
    },
    {
      "path": "calibration.js",
      "from": "calibration.js",
      "mode": "0644"
    },
    {
      "path": "uds.js",
      "from": "uds.js",
      "mode": "0644"
    },
    {
      "path": "ambient.js",
      "from": "ambient.js",
      "mode": "0644"
    },
    {
      "path": "seat.js",
      "from": "seat.js",
      "mode": "0644"
    },
    {
      "path": "hmictl",
      "from": "hmictl",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "iteriodev-comfort.service",
      "from": "iteriodev-comfort.service"
    }
  ],
  "enable": [
    {
      "unit": "iteriodev-comfort.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "iteriodev-comfort"
  ],
  "crashNames": [
    "hmictl"
  ],
  "restart": [
    "iteriodev-comfort.service"
  ]
}

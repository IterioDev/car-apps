      "gpu": "text",
      "x": 40,
      "y": 415,
      "w": 1360,
      "h": 85,
      "opts": {
        "text": "2. Move rearward manually to your rear reference. Stop and capture the limit; a 30-count buffer is added.",
        "size": 28,
        "font": "label",
        "color": "#f2f2f2",
        "align": "left",
        "wrap": true
      }
    },
    {

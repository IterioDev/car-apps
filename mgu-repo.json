{
 "schema": 1,
 "apps": {
  "path": "apps/*",
  "build": {
   "node": "tools/prebuilt.js",
   "output": "{dir}/{id}@{version}.tgz"
  },
  "uninstallable": true
 },
 "tools": [
  {
   "id": "iteriodev-comfort",
   "path": "tools/iteriodev-comfort"
  },
  {
   "id": "iteriodev-overlays",
   "path": "tools/iteriodev-overlays"
  },
  {
   "id": "iteriodev-screencast",
   "path": "tools/iteriodev-screencast"
  },
  {
   "id": "iteriodev-tailscale",
   "path": "tools/iteriodev-tailscale"
  },
  {
   "id": "iteriodev-turnview",
   "path": "tools/iteriodev-turnview"
  }
 ]
}
